{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string" },
        "storageClass": { "type": "string" }
      }
    },
    "dns": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": { "type": "string" },
        "podLabels": { "type": "object", "minProperties": 1 }
      }
    }
  },
  "properties": {
    "global": { "type": "object" },
    "enabled": { "type": "boolean" },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "model": { "type": "string", "minLength": 1 },
        "embedModel": { "type": "string", "minLength": 1 },
        "pullModels": { "type": "boolean" },
        "audience": { "type": "string", "minLength": 1 },
        "ratePerMinute": { "type": "number", "exclusiveMinimum": 0 },
        "runbookMinScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "logLevel": { "enum": ["DEBUG", "INFO", "WARNING", "ERROR"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "resources": { "type": "object" },
        "podAnnotations": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" }
      }
    },
    "ollama": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "externalUrl": { "type": "string" },
        "image": { "$ref": "#/definitions/image" },
        "keepAlive": { "type": "string" },
        "persistence": { "$ref": "#/definitions/persistence" },
        "resources": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" }
      }
    },
    "qdrant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/image" },
        "persistence": { "$ref": "#/definitions/persistence" },
        "resources": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" }
      }
    },
    "crds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install": { "type": "boolean" },
        "keep": { "type": "boolean" }
      }
    },
    "agentNamespaceSelector": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string" }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "dns": { "$ref": "#/definitions/dns" },
            "apiServer": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cidrs": { "type": "array", "items": { "type": "string" } },
                "ports": { "type": "array", "items": { "type": "integer" }, "minItems": 1 }
              }
            },
            "ollamaInternet": { "type": "boolean" }
          }
        }
      }
    }
  }
}
